<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>alluxio-table-server</artifactId>
    <groupId>org.alluxio</groupId>
    <version>2.9.6</version>
  </parent>
  <artifactId>alluxio-table-server-underdb</artifactId>
  <packaging>pom</packaging>
  <name>Alluxio Table - Server - UnderDB</name>
  <description>Alluxio table underDB implementations</description>

  <modules>
    <module>hive</module>
    <!--
      Sophos fork: alluxio-table-server-underdb-glue is excluded from
      the reactor.  The Sophos Central deployment does not run the
      Alluxio table catalog service against AWS Glue (or any external
      metastore via the Glue UDB), so the resulting jar was already
      absent from the shipped tarball: the upstream Go packager
      (dev/scripts/.../generate-tarball.go) never copies any
      alluxio-table-* artifact into lib/, only the underfs- and
      integration-tools- jars listed in cmd/common.go's defaultLibJars.
      Building the module anyway pulled aws-java-sdk-glue / -core
      v1.11.820 (now v1.12.797) and ~hive 2.3.7 transitive deps onto
      the BlackDuck source-side dep graph for no runtime benefit, and
      kept ~50 com.amazonaws.* import lines alive that would block a
      future v1-only SDK retirement.  The source tree under
      table/server/underdb/glue/ is left in place so the diff against
      upstream stays minimal and a future hive-style restore is a
      one-line revert.
    -->
  </modules>

  <properties>
    <!-- These need to be defined here as well as in the parent pom so that mvn can run
         properly from sub-project directories -->
    <build.path>${project.parent.parent.parent.basedir}/build</build.path>
    <lib.jar.name>${project.artifactId}-${project.version}.jar</lib.jar.name>
  </properties>

  <dependencies>
    <!-- Internal dependencies (must have provided scope) -->
    <dependency>
      <groupId>org.alluxio</groupId>
      <artifactId>alluxio-table-base</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.alluxio</groupId>
      <artifactId>alluxio-table-server-common</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>shade</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>${project.artifactId}-${project.version}-jar-with-dependencies</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>LICENSE</exclude>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <filesets>
            <fileset>
              <directory>${basedir}/../../../../lib</directory>
              <includes>
                <include>**/${project.artifactId}-*.jar</include>
              </includes>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
